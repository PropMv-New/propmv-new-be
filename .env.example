# =============================================================================
# PROPMV Backend - Scheduler / cron configuration
# =============================================================================
# All variables below are REQUIRED for cron jobs to run. Do not comment out.
# See docs/SCHEDULED_JOBS.md for details on each job.
#
# Production: copy this entire block into .env.production and set
# BACKGROUND_WORKERS_EMBEDDED=false + run `npm run workers` separately.

# Master switch - disables ALL API schedulers when false
SCHEDULERS_ENABLED=true

# Central timezone for all daily cron jobs (times below are in this zone)
CRON_TIMEZONE=UTC
SCHEDULER_SKIP_STARTUP_RUN=true
SCHEDULER_LEADER_LOCK_ENABLED=true
SCHEDULER_LEADER_LOCK_MS=3600000

# Staggered daily job times (UTC) - one job per slot to reduce server load
OWNERSHIP_TRANSFER_SCHEDULE_TIME=00:00
FUTURE_INVOICE_NOTIFICATION_TIME=00:15
INVOICE_NOTIFICATION_TIME=00:30
OVERDUE_NOTIFICATION_TIME=00:45
NOTE_REMINDER_NOTIFICATION_TIME=01:00
MAINTENANCE_NOTIFICATION_TIME=01:15
LATE_FEE_NOTIFICATION_TIME=01:30

# Daily task enable flags
HOA_INVOICE_REMINDER_SCHEDULER_ENABLED=true
HOA_INVOICE_OVERDUE_REMINDER_SCHEDULER_ENABLED=true
HOA_INVOICE_EXTENSION_SCHEDULER_ENABLED=true
HOA_NOTE_REMINDER_SCHEDULER_ENABLED=true
HOA_OWNERSHIP_TRANSFER_SCHEDULER_ENABLED=true
HOA_MAINTENANCE_NOTIFICATION_SCHEDULER_ENABLED=true
HOA_LATE_FEE_NOTIFICATION_SCHEDULER_ENABLED=true

# Property-local late-fee generation (hourly checker - separate from CRON_SCHEDULE)
LATE_FEE_HOURLY_SCHEDULER_ENABLED=true
LATE_FEE_STARTUP_DELAY_MS=60000
HOA_LATE_FEE_LEGACY_DAILY_SCHEDULER_ENABLED=false

# Ownership transfer
HOA_OWNERSHIP_TRANSFER_STARTUP_DELAY_MS=120000

# Zillow bulk feed (twice daily ET - external syndication requirement)
ZILLOW_BULK_FEED_ENABLED=true
ZILLOW_BULK_FEED_CRON_ENABLED=true
ZILLOW_BULK_FEED_RUN_HOURS_ET=4,16
ZILLOW_BULK_FEED_RUN_MINUTE_ET=30
ZILLOW_BULK_FEED_STARTUP_DELAY_MS=120000

# Payload payments (preferred embedded gateway when PAYLOAD_ENABLED=true)
PAYLOAD_ENABLED=false
PAYLOAD_SECRET_KEY=
# Deprecated for UI - embeds use ephemeral client tokens from POST /access_tokens (see docs/PAYLOAD_FOUNDATION.md)
PAYLOAD_CLIENT_KEY=
PAYLOAD_ENVIRONMENT=sandbox
# plugin (sandbox default) | api | auto - see docs/PAYLOAD_FOUNDATION.md
PAYLOAD_MERCHANT_ONBOARDING_MODE=plugin
PAYLOAD_BASE_URL=https://api.payload.com
PAYLOAD_ORG_PROCESSING_ID=
# Do NOT set PAYLOAD_WEBHOOK_SECRET - Payload v2 docs do not document inbound signing (see docs/PAYLOAD_FOUNDATION.md).
PAYLOAD_TERMS_URL=
PAYLOAD_TIMEOUT_MS=20000
# Demo-only Check21 remote deposit (HOA board settings). Not settlement.
PAYLOAD_CHECK21_ENABLED=false
# Optional docs-JSON wire format (default multipart only; live API rejects docs JSON)
PAYLOAD_CHECK21_DOCS_JSON=false

# Rainforest webhook retry (legacy - disable when using Payload only)
RAINFOREST_OPS_CRON_ENABLED=true
RAINFOREST_OPS_STARTUP_DELAY_MS=30000
RAINFOREST_WEBHOOK_RETRY_INTERVAL_MS=300000
RAINFOREST_WEBHOOK_RETRY_BATCH_SIZE=25

# Audit outbox delivery worker
AUDIT_OUTBOX_ENABLED=true
AUDIT_OUTBOX_POLL_INTERVAL_MS=5000
AUDIT_OUTBOX_STARTUP_DELAY_MS=10000
AUDIT_OUTBOX_BATCH_SIZE=20

# Email bounce IMAP poller (set true when IMAP credentials are configured)
EMAIL_BOUNCE_IMAP_ENABLED=false
EMAIL_BOUNCE_IMAP_POLL_MS=300000

# Background job workers (process jobs enqueued by schedulers)
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_WORKERS_EMBEDDED=true
REDIS_URL=redis://127.0.0.1:6379

# Billing / business timezone (HOA calendar dates - separate from CRON_TIMEZONE)
APP_TIMEZONE=America/New_York
HOA_MONGO_TIMEZONE=America/New_York

# Legacy aliases (CRON_SCHEDULE + CRON_TIMEZONE take precedence)
AUTOMATED_NOTIFICATION_TIME=00:00
AUTOMATED_NOTIFICATION_TIMEZONE=UTC
AUTOMATED_NOTIFICATION_SKIP_STARTUP_RUN=true

# =============================================================================
# Rate limiting (set false to disable; per-route limits use built-in defaults)
# =============================================================================
RATE_LIMIT_ENABLED=true

# Auth tiers (examples - omit to use built-in defaults)
# RATE_LIMIT_AUTH_LOGIN_LIMIT=10
# RATE_LIMIT_AUTH_LOGIN_WINDOW_MINUTES=15
# RATE_LIMIT_AUTH_SEND_OTP_LIMIT=4
# RATE_LIMIT_AUTH_SEND_OTP_WINDOW_MINUTES=15

# Marketing / address public endpoints
# MARKETING_SUBSCRIPTION_RATE_LIMIT_PER_MIN=20
# MARKETING_VISIT_RATE_LIMIT_PER_MIN=120
# MARKETING_DEMO_REQUEST_RATE_LIMIT_PER_HOUR=5
# ADDRESS_RATE_LIMIT_PER_MIN=90
# ADDRESS_USAGE_RATE_LIMIT_PER_MIN=600

# OTP resend progressive cooldown (seconds list) + lockout
# OTP_RESEND_COOLDOWN_SECONDS=30,60,120
# OTP_RESEND_MAX_ATTEMPTS=3
# OTP_RESEND_LOCKOUT_SECONDS=300
# OTP_RESEND_STATE_TTL_MINUTES=15
