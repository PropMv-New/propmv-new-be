{
  "info": {
    "_postman_id": "propmv-payments-collection-003",
    "name": "PropMv – Payments (Straddle only)",
    "description": "Payment endpoints using Straddle only. Stripe is commented out and can be re-enabled later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "<JWT_TOKEN>"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "bankAccountId",
      "value": ""
    },
    {
      "key": "straddlePaykeyId",
      "value": ""
    },
    {
      "key": "chargeId",
      "value": ""
    },
    {
      "key": "payoutId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer (Straddle)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "  pm.collectionVariables.set('customerId', res.data._id);",
                  "  console.log('customerId saved:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane.smith.test@example.com\",\n  \"phone\": \"+15550001234\",\n  \"type\": \"individual\",\n  \"dob\": \"1990-05-15\",\n  \"ssn\": \"123-45-6789\",\n  \"address\": {\n    \"line1\": \"123 Main St\",\n    \"city\": \"Austin\",\n    \"state\": \"TX\",\n    \"zip\": \"78701\"\n  },\n  \"ipAddress\": \"203.0.113.1\",\n  \"metadata\": {\n    \"role\": \"tenant\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "customers"
              ]
            },
            "description": "Creates customer in Straddle only. Auto-saves MongoDB _id into {{customerId}}.\n\nUse a unique email each time - Straddle rejects duplicate emails with 422."
          }
        },
        {
          "name": "Create Customer (Straddle) – Business",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "  pm.collectionVariables.set('customerId', res.data._id);",
                  "  console.log('customerId saved:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"email\": \"acme.test@example.com\",\n  \"phone\": \"+15550009999\",\n  \"type\": \"business\",\n  \"dob\": \"1990-05-15\",\n  \"ssn\": \"123-45-6789\",\n  \"ein\": \"12-3456789\",\n  \"legalBusinessName\": \"Acme Corp LLC\",\n  \"website\": \"https://acme.com\",\n  \"address\": {\n    \"line1\": \"456 Business Ave\",\n    \"city\": \"Austin\",\n    \"state\": \"TX\",\n    \"zip\": \"78701\"\n  },\n  \"ipAddress\": \"203.0.113.1\",\n  \"metadata\": {\n    \"role\": \"business\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "customers"
              ]
            },
            "description": "Creates a business customer in Straddle with compliance_profile containing ein, legal_business_name, website, dob, ssn."
          }
        },
        {
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "customers"
              ]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "customers",
                "{{customerId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bank Accounts",
      "item": [
        {
          "name": "Link Bank Account (Straddle paykey)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "  pm.collectionVariables.set('bankAccountId', res.data._id);",
                  "  const paykeyId = res.data.straddle && res.data.straddle.gatewayId;",
                  "  if (paykeyId) {",
                  "    pm.collectionVariables.set('straddlePaykeyId', paykeyId);",
                  "    console.log('straddlePaykeyId saved:', paykeyId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentCustomerId\": \"{{customerId}}\",\n  \"holderName\": \"Jane Smith\",\n  \"accountNumber\": \"000123456789\",\n  \"routingNumber\": \"110000000\",\n  \"accountType\": \"checking\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/bank-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "bank-accounts"
              ]
            },
            "description": "Links a bank account to Straddle (creates a paykey).\n\npaymentCustomerId = MongoDB _id from Create Customer response (auto-filled via {{customerId}}).\n\nTest values for Straddle sandbox:\n- routingNumber: 110000000\n- accountNumber: any number e.g. 000123456789\n\nAuto-saves bankAccountId and straddlePaykeyId (straddle.gatewayId) for use in charges/payouts."
          }
        },
        {
          "name": "List Bank Accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/bank-accounts?customerId={{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "bank-accounts"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}",
                  "description": "Optional – filter by PaymentCustomer MongoDB _id"
                }
              ]
            }
          }
        },
        {
          "name": "Get Bank Account by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/bank-accounts/{{bankAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "bank-accounts",
                "{{bankAccountId}}"
              ]
            }
          }
        },
        {
          "name": "Update Bank Account (Straddle paykey)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderName\": \"Jane M. Smith\",\n  \"accountType\": \"savings\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/bank-accounts/{{bankAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "bank-accounts",
                "{{bankAccountId}}"
              ]
            },
            "description": "Updates holderName and/or accountType in Straddle. At least one field required."
          }
        }
      ]
    },
    {
      "name": "Charges",
      "item": [
