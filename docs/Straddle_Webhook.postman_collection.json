  "item": [
    {
      "name": "Payment Created - Full Payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account_id\": \"857c679a-8e80-47f1-9334-39dd08ea801f\",\n  \"event_id\": \"evt_created_{{$timestamp}}\",\n  \"event_type\": \"payout.event.v1\",\n  \"data\": {\n    \"id\": \"payout_{{$timestamp}}\",\n    \"status\": \"created\",\n    \"amount\": 50000,\n    \"currency\": \"usd\",\n    \"description\": \"Rent payment\",\n    \"paykey\": \"pk_test_123\",\n    \"paykey_details\": {\n      \"id\": \"033de251-fda3-4f86-90d7-2ce4000b2d51\",\n      \"customer_id\": \"a773843f-e6f0-4ac0-b3df-b1dc720a4d57\",\n      \"label\": \"Primary Account\",\n      \"balance\": 50000\n    },\n    \"customer_details\": {\n      \"id\": \"03ece916-5d0e-46f7-a28a-e7f1aab1dbc3\",\n      \"name\": \"John Doe\",\n      \"email\": \"john@example.com\",\n      \"phone\": \"+1234567890\",\n      \"customer_type\": \"individual\"\n    },\n    \"payment_rail\": \"ach\",\n    \"consent_type\": \"web\",\n    \"metadata\": {\n      \"tenantId\": \"tenant_123\",\n      \"propertyId\": \"prop_456\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/straddle/payment-status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "straddle", "payment-status"]
        }
