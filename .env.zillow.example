
# =============================================================================
# Zillow Rentals (ZGR) Syndication - complete configuration
# Copy this block into .env, .env.local, and .env.production (adjust per environment)
# =============================================================================

# --- Core ---
ZILLOW_SYNDICATION_ENABLED=true
ZILLOW_ENV=test
ZILLOW_PLATFORM_ID=zillow

# --- Zillow external API keys (from Feed Connect onboarding) ---
ZILLOW_API_KEY_TEST=
ZILLOW_API_KEY_PROD=
ZILLOW_FEED_ID=
ZILLOW_COMPANY_ID=

# --- Zillow external API URLs ---
ZILLOW_MARK_FOR_UPDATE_URL_TEST=https://feeds.testpads.net/listing-tools/api/v1/externalListing/markForUpdate
ZILLOW_MARK_FOR_UPDATE_URL_PROD=https://api.zillowrentals.com/listing-tools/api/v1/externalListing/markForUpdate
ZILLOW_GET_STATUS_URL=https://listing-tools-api.hotpads.com/listing-tools/api/v1/syndication/getStatus
ZILLOW_SIGNUP_URL=https://www.zillow.com/rentals-network/listing-feeds/

# --- PropMv public base URLs (used to build callback/feed URLs) ---
# Use 127.0.0.1 (not localhost) when ZILLOW_MOCK_ENABLED=true to avoid IPv6 ::1 self-call errors.
API_PUBLIC_BASE_URL=http://127.0.0.1:5000
API_BASE_PATH=/api/v1

# --- PropMv Zillow API route prefix & paths ---
ZILLOW_API_ROUTE_PREFIX=/api/v1/zillow
ZILLOW_CALLBACK_ROUTE=/callback
ZILLOW_BULK_FEED_REGENERATE_ROUTE=/bulk-feed/regenerate
ZILLOW_BULK_FEED_CONFIRM_ROUTE=/bulk-feed/confirm

# --- PropMv landlord syndication API paths (relative to /api/v1/landlord) ---
ZILLOW_LANDLORD_SYNDICATION_STATUS_ROUTE=/listing/listings/:id/syndication
ZILLOW_LANDLORD_SYNDICATION_LIVE_ROUTE=/listing/listings/:id/syndication/live
ZILLOW_LANDLORD_SYNDICATION_SYNC_ROUTE=/listing/listings/:id/syndication/zillow/sync
ZILLOW_LANDLORD_SYNDICATION_REMOVE_ROUTE=/listing/listings/:id/syndication/zillow/remove

# --- Full public URLs (override auto-built URLs when using CDN/reverse proxy) ---
ZILLOW_CALLBACK_URL=http://localhost:5000/api/v1/zillow/callback
ZILLOW_BULK_FEED_PUBLIC_URL=http://localhost:5000/feeds/zillow/hotpads.xml
ZILLOW_BULK_FEED_REGENERATE_URL=http://localhost:5000/api/v1/zillow/bulk-feed/regenerate
ZILLOW_BULK_FEED_CONFIRM_URL=http://localhost:5000/api/v1/zillow/bulk-feed/confirm
ZILLOW_LANDLORD_SYNDICATION_STATUS_URL=http://localhost:5000/api/v1/landlord/listing/listings/:id/syndication
ZILLOW_LANDLORD_SYNDICATION_SYNC_URL=http://localhost:5000/api/v1/landlord/listing/listings/:id/syndication/zillow/sync
ZILLOW_LANDLORD_SYNDICATION_REMOVE_URL=http://localhost:5000/api/v1/landlord/listing/listings/:id/syndication/zillow/remove

# --- Default listing contact (fallback when property owner contact missing) ---
ZILLOW_DEFAULT_CONTACT_EMAIL=syndication@propmv.com
ZILLOW_DEFAULT_CONTACT_PHONE=8005550100

# --- Feature toggles ---
ZILLOW_REALTIME_ENABLED=true
ZILLOW_BULK_FEED_ENABLED=true
ZILLOW_BULK_FEED_CRON_ENABLED=true
ZILLOW_BULK_FEED_GZIP=true

# --- Bulk feed schedule (US Eastern; run 20-30 min before Zillow fetch) ---
ZILLOW_BULK_FEED_RUN_HOURS_ET=4,16
ZILLOW_BULK_FEED_RUN_MINUTE_ET=30
ZILLOW_BULK_FEED_STARTUP_DELAY_MS=120000
ZILLOW_BULK_FEED_THRESHOLD_PERCENT=20

# --- Bulk feed file paths (static - never include timestamps in filename) ---
ZILLOW_BULK_FEED_PUBLIC_PATH=/feeds/zillow
ZILLOW_BULK_FEED_LOCAL_DIR=./public/feeds/zillow
ZILLOW_BULK_FEED_FILENAME=hotpads.xml

# --- HTTP client (real-time API) ---
ZILLOW_HTTP_TIMEOUT_MS=30000
ZILLOW_HTTP_MAX_RETRIES=3
ZILLOW_HTTP_RETRY_BASE_DELAY_MS=500

# --- Mock Zillow API (local E2E testing without Zillow credentials) ---
# Set ZILLOW_MOCK_ENABLED=true - mock routes use the exact same path suffixes as real Zillow APIs.
ZILLOW_MOCK_ENABLED=false
ZILLOW_MOCK_API_KEY=mock-zillow-api-key
ZILLOW_MOCK_FEED_ID=mock-feed-id
ZILLOW_MOCK_COMPANY_ID=mock-company-id
ZILLOW_MOCK_SIMULATE_CALLBACK=true
ZILLOW_MOCK_CALLBACK_DELAY_MS=500
# Optional URL overrides (defaults: API_PUBLIC_BASE_URL + exact Zillow path suffix):
# ZILLOW_MARK_FOR_UPDATE_URL_MOCK=http://localhost:5000/listing-tools/api/v1/externalListing/markForUpdate
# ZILLOW_GET_STATUS_URL_MOCK=http://localhost:5000/listing-tools/api/v1/syndication/getStatus
