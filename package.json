    "imap": "^0.8.17",
    "ioredis": "^6.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "juice": "^12.1.0",
    "mailparser": "^3.9.15",
    "mongodb": "^6.20.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "redis": "^5.0.0",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
