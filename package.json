    "verify:email-template-flags:real": "node -e \"process.env.EMAIL_TEMPLATE_VERIFY_MODE='real'; require('./scripts/verify-email-template-flags.js')\"",
    "ensure:email-delivery-indexes": "node scripts/ensure-email-delivery-indexes.js",
    "poll:email-bounces": "node scripts/poll-email-bounces.js",
    "ingest:email-bounce": "node scripts/ingest-email-bounce.js",
    "suppress:email": "node scripts/suppress-email.js",
    "unsuppress:email": "node scripts/unsuppress-email.js",
    "check:smtp-rcpt": "node scripts/check-smtp-rcpt-verify.js",
    "mcp:test-server": "node ../tests/mcp/server.mjs",
    "mcp:test-server:check": "node --check ../tests/mcp/server.mjs"
